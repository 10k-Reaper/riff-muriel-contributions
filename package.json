{
  "name": "muriel",
  "version": "1.0.0",
  "main": "main.js",
  "bin": {
    "muriel": "./cli.js"
  },
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dist": "electron-builder",
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "keywords": [],
  "author": "cloverscripts",
  "license": "MIT",
  "description": "Muriel - a lightweight music player.",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "cfonts": "^3.3.1",
    "hls.js": "^1.7.1",
    "tone": "^15.1.22"
  },
  "productName": "Muriel",
  "homepage": "https://github.com/cloverscripts/riff-muriel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloverscripts/riff-muriel.git"
  },
  "bugs": {
    "url": "https://github.com/cloverscripts/riff-muriel/issues"
  },
  "build": {
    "appId": "io.github.cloverscripts.muriel",
    "productName": "Muriel",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!.github/**",
      "!dist/**",
      "!bin/**",
      "!*.md",
      "!strip_comments.js",
            "!package-lock.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cloverscripts",
        "repo": "riff-muriel",
        "releaseType": "release"
      }
    ]
  }
}
